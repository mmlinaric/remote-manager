<configuration>
    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder>
            <pattern>%level %logger{36}: %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="com.mmlinaric.remotemanager" level="INFO"/>
    <root level="WARN">
        <appender-ref ref="STDERR"/>
    </root>
</configuration>
